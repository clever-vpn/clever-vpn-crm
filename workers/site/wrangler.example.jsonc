{
  // site-serve：客户站点的出口。零 D1，只读 KV 指针 + R2 产物。
  // 契约：clever-vpn-docs/docs/contracts/cf-api-hosting.md
  //
  // 自部署与 SaaS 跑的是同一份代码；差别只在"谁把这两个绑定填上"。
  // 本地开发不需要真实 id（wrangler dev 会用本地模拟）。
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "site-serve",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      // host:* → { tenant_id, slot, shard, status }
      // site:*:active → { n }
      "binding": "HOSTS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      // sites/{tenant}/versions/{n}/public/...
      "binding": "SITES",
      "bucket_name": "REPLACE_WITH_BUCKET_NAME"
    }
  ],
  "vars": {
    // 租户后台域名的父域：{tenant}.<ADMIN_ZONE>
    "ADMIN_ZONE": "app.example.com",
    "PLATFORM_VERSION": "dev"
  }
  // 域名绑定（不写在这里）：
  //   1) 自己的 zone：给本 Worker 加 Custom Domain / 通配 Route
  //   2) 租户自定义域：Cloudflare for SaaS 的 custom hostname 指向 fallback origin
}
