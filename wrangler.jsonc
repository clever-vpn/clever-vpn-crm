{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clever-vpn-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 静态资源：管理后台 SPA（vite 产物，web/dist/admin）。
  // 文件命中时由边缘直接返回、不执行 Worker；未命中才回到 Worker（/api/*、深链接回落 index.html）。
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 关掉自动斜杠/扩展名处理：SPA 深链接由 Worker 回落 index.html，
    // 否则 /admin/settings 会被 307 成 /admin/（丢了路由）。
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // **只有一个时钟**：`*/2` 是"队列泵的心跳"，不是"所有活每 2 分钟干一遍"。
  // 具体分频在 `src/index.ts` 的 `scheduled()` 里：
  //   门 B（距上次 ≥55 分钟，自愈门）→ 补落账 / 周期结算 / 到期礼包探测，独占该 tick
  //   门 A（其余 tick）            → 查单（退避曲线）+ 通知泵（按日配额）
  // 为什么不用多个 cron：所有活共享单次 invocation 的 30s CPU 预算，一个时钟更容易
  // 说清"这一 tick 到底该干什么"，也不会出现两个 cron 同时抢预算。
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // 站点**指针**：`site:<租户>:active → { n }`（谁在线上由它说了算）。
  //
  // 为什么非有不可：产物版本不可变、回滚靠切指针，所以指针必须有一处**单点**可写。
  // 本地 `wrangler dev` 用模拟 KV，id 写占位就行；线上由部署工作流创建并渲染真 id
  // （`HOSTS_KV_ID`，见 scripts/render-config.mjs）。
  "kv_namespaces": [
    {
      "binding": "HOSTS",
      "id": "REPLACE_WITH_HOSTS_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      // 站点产物：sites/<租户>/versions/<n>/public/…
      // 与 site-serve（workers/site）读写同一布局；不建站点可不绑
      "binding": "SITES",
      "bucket_name": "clever-sites"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clever-vpn-crm",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      // 迁移由 CI 应用（见 .github/workflows/deploy.yml）
      "migrations_dir": "migrations-dev"
    }
  ],
  // 由 wrangler secret put 提供（不要写进仓库）：
  //   APP_SECRET          唯一主密钥：HMAC 签名 + AES-GCM 加密（派生后用途隔离）
  // cf-api 租户 token 不走 secret：后台「设置 → cf-api 对接」填，加密存进 D1
  "vars": {
    "CRM_TENANT_ID": "0",
    // 两个 studio 的对外地址 —— 票据跳转的落点，**只来自服务端配置**（契约
    // `studio-identity.md` §2.1：接受请求参数就是开放重定向）。空 = 该产品不可用。
    "STUDIO_SITE_URL": "",
    "STUDIO_APP_URL": "",
    "CF_API_BASE": "https://api.clever-vpn.org",
    "CRM_CODE_VERSION": "dev",
    "CRM_CONTRACT_VERSION": "19",
    // 非 production ⇒ 验证码直接回显给客户端（本地联调）；部署时由 CI 覆盖
    "ENVIRONMENT": "development",
    // 官网（独立静态站）地址。留空则根路径显示一句部署提示。
    // 跨域调用 /api/app/v1 不需要任何白名单：CORS 是浏览器规矩，不是信任名单。
    "SITE_URL": ""
  }
}
