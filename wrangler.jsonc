{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clever-vpn-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 静态资源：管理后台 SPA（vite 产物，web/dist/admin）。
  // 文件命中时由边缘直接返回、不执行 Worker；未命中才回到 Worker（/api/*、深链接回落 index.html）。
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 关掉自动斜杠/扩展名处理：SPA 深链接由 Worker 回落 index.html，
    // 否则 /admin/settings 会被 307 成 /admin/（丢了路由）。
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clever-vpn-crm",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  // 由 wrangler secret put 提供（不要写进仓库）：
  //   CF_API_TOKEN    租户 API Token（cv_api_…）
  //   SESSION_SECRET  会话签名密钥
  "vars": {
    "CRM_TENANT_ID": "0",
    "CF_API_BASE": "https://api.clever-vpn.org",
    "CRM_CODE_VERSION": "dev",
    "CRM_CONTRACT_VERSION": "1"
  }
}
