{
  "name": "clever-vpn-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "dev:app-web": "node scripts/dev-app-web.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:web": "npm run build:site && vite build",
    "deploy": "wrangler deploy",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "vite": "^6.4.5",
    "vitest": "^3",
    "wrangler": "^4"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.29.3",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
