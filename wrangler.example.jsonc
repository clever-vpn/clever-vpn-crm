{
  // 自托管模板：复制为 wrangler.jsonc 后按注释填写。
  //   cp wrangler.example.jsonc wrangler.jsonc
  //   npx wrangler d1 create clever-vpn-crm     # 用返回的 database_id 替换下面
  //   npx wrangler secret put CF_API_TOKEN
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clever-vpn-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      // 自托管只有一个库：1 Worker + 1 D1
      "binding": "DB",
      "database_name": "clever-vpn-crm",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "vars": {
    // 你在 cf-api 的租户 ID（激活码/许可都挂在它下面）
    "CRM_TENANT_ID": "0",
    "CF_API_BASE": "https://api.clever-vpn.org",
    // 由 CI/部署脚本注入；本地开发可保持 dev
    "CRM_CODE_VERSION": "dev",
    "CRM_CONTRACT_VERSION": "1"
  }
  // 自定义域名（可选）：在租户自己的 Cloudflare zone 里给这个 Worker 配 Custom Domain，
  // 不需要在这里写 routes。
}
